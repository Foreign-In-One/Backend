# Database 설정
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3308/paycheck_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SERVER_PORT=8080

# OpenAI API Key (미설정 시 내장 Mock AI Agent로 자동 Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Cloud Document AI 설정 (미설정 시 내장 Mock OCR로 자동 Fallback)
DOCUMENTAI_PROJECT_ID=
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# 파일 업로드 디렉터리
UPLOAD_DIR=uploads
